{
  "name": "Mono Tools",
  "description": "Mono Tools Created By Minh Viet",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "./images/logo_16_16.png",
    "48": "./images/logo_48_48.png",
    "128": "./images/logo_128_128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "gcm",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": "./images/logo_48_48.png"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  }
}
