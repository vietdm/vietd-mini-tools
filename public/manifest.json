{
  "name": "VietD Mini Tools",
  "description": "A lightweight Chrome extension by VietD that gathers handy personal tools in one place. Quickly generate UUIDs, create bcrypt hashes, random values, and more — all in a single click",
  "version": "1.1.1",
  "manifest_version": 3,
  "icons": {
    "16": "./images/logo_16_16.png",
    "48": "./images/logo_48_48.png",
    "128": "./images/logo_128_128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "gcm",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": "./images/logo_48_48.png"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  }
}
